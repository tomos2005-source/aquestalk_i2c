<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="Oj/l.qpAh|.p,MoS/ahw" x="20" y="20"><statement name="HANDLER"><block type="typescript_statement" id="bQ?:U#R5xf5OxLb$`==e"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace aquestalk {" line1="" line2="    const I2C_ADDR = 46; // ATP3012のデフォルトI2Cアドレス (0x2E)" line3="" line4="    // ==========================================" line5="    // 基本のしゃべるブロック" line6="    // ==========================================" line7="" line8="    /**" line9="     * ローマ字でテキストをしゃべらせます。" line10="     * @param text 音声記号（例: &quot;ohayou&quot;）, eg: &quot;ohayou&quot;" line11="     */" line12="    //% block=&quot;しゃべる %text&quot;" line13="    export function say(text: string): void {" line14="        sendText(text);" line15="    }" line16="" line17="    /**" line18="     * 数値を1つずつ「いち・に・さん」と順番に読み上げます。" line19="     * @param num 読む数字, eg: &quot;3.14&quot;" line20="     */" line21="    //% block=&quot;数字を1つずつ読む %num&quot;" line22="    export function sayNumber(num: string): void {" line23="        sendText(&quot;&lt;NUM VAL=&quot; + num + &quot;&gt;&quot;);" line24="    }" line25="" line26="    /**" line27="     * 数値を「せんにひゃくさんじゅうよん」と位（桁）をつけて読み上げます。" line28="     * @param num 読む数字, eg: &quot;1234&quot;" line29="     */" line30="    //% block=&quot;数字を桁付きで読む %num&quot;" line31="    export function sayNumberDigits(num: string): void {" line32="        sendText(&quot;&lt;NUMK VAL=&quot; + num + &quot;&gt;&quot;);" line33="    }" line34="" line35="    /**" line36="     * アルファベットや記号を読み上げます。" line37="     * @param text 読む英数字（例: &quot;AT-3568P&quot;）, eg: &quot;AT-3568P&quot;" line38="     */" line39="    //% block=&quot;アルファベットを読む %text&quot;" line40="    export function sayAlpha(text: string): void {" line41="        sendText(&quot;&lt;ALPHA VAL=&quot; + text + &quot;&gt;&quot;);" line42="    }" line43="" line44="    // ==========================================" line45="    // つなげて喋るブロック（1文にまとめてスムーズに発声）" line46="    // ==========================================" line47="" line48="    /**" line49="     * 前後の言葉と数字（1つずつ読み）をつなげて1文でしゃべらせます。" line50="     * @param text1 前の言葉, eg: &quot;korewa&quot;" line51="     * @param num 数字, eg: &quot;123&quot;" line52="     * @param text2 後の言葉, eg: &quot;desu&quot;" line53="     */" line54="    //% block=&quot;つなげて喋る(1つずつ) 前%text1 数字%num 後%text2&quot;" line55="    export function sayNumberCombined(text1: string, num: string, text2: string): void {" line56="        let fullText = text1 + &quot;&lt;NUM VAL=&quot; + num + &quot;&gt;&quot; + text2;" line57="        sendText(fullText);" line58="    }" line59="" line60="    /**" line61="     * 前後の言葉と数字（桁付き読み）をつなげて1文でしゃべらせます。" line62="     * @param text1 前の言葉, eg: &quot;gonokoudaiga&quot;" line63="     * @param num 数字, eg: &quot;321&quot;" line64="     * @param text2 後の言葉, eg: &quot;yen&quot;" line65="     */" line66="    //% block=&quot;つなげて喋る(桁付き) 前%text1 数字%num 後%text2&quot;" line67="    export function sayDigitsCombined(text1: string, num: string, text2: string): void {" line68="        let fullText2 = text1 + &quot;&lt;NUMK VAL=&quot; + num + &quot;&gt;&quot; + text2;" line69="        sendText(fullText2);" line70="    }" line71="" line72="    /**" line73="     * 単位をつけて数字と前後の言葉をつなげて1文でしゃべらせます。" line74="     * @param text1 前の言葉, eg: &quot;ringoga&quot;" line75="     * @param num 数字, eg: &quot;3&quot;" line76="     * @param counter 単位（例: &quot;ko&quot;）, eg: &quot;ko&quot;" line77="     * @param text2 後の言葉, eg: &quot;arimasu&quot;" line78="     */" line79="    //% block=&quot;単位付きでつなげて喋る 前%text1 数字%num 単位%counter 後%text2&quot;" line80="    export function sayDigitsCounterCombined(text1: string, num: string, counter: string, text2: string): void {" line81="        let fullText3 = text1 + &quot;&lt;NUMK VAL=&quot; + num + &quot; COUNTER=&quot; + counter + &quot;&gt;&quot; + text2;" line82="        sendText(fullText3);" line83="    }" line84="" line85="    // ==========================================" line86="    // 記号変換ブロック（「しゃべる」や標準のテキスト結合にはめ込んで使う）" line87="    // ==========================================" line88="" line89="    /**" line90="     * 数字（1つずつ読み）を音声記号テキストに変換します。" line91="     * @param num 読む数字, eg: &quot;123&quot;" line92="     */" line93="    //% block=&quot;数字(1つずつ) %num&quot;" line94="    export function numSymbol(num: string): string {" line95="        return &quot;&lt;NUM VAL=&quot; + num + &quot;&gt;&quot;;" line96="    }" line97="" line98="    /**" line99="     * 数字（桁付き読み）を音声記号テキストに変換します。" line100="     * @param num 読む数字, eg: &quot;123&quot;" line101="     */" line102="    //% block=&quot;数字(桁付き) %num&quot;" line103="    export function numkSymbol(num: string): string {" line104="        return &quot;&lt;NUMK VAL=&quot; + num + &quot;&gt;&quot;;" line105="    }" line106="" line107="    // ==========================================" line108="    // 設定・制御ブロック" line109="    // ==========================================" line110="" line111="    /**" line112="     * 話すスピード、声の高さ、音量を変更してしゃべらせます。" line113="     * @param text 音声記号, eg: &quot;ohayou&quot;" line114="     * @param speed 話す速さ (50~300), eg: 100" line115="     * @param pitch 声の高さ (50~200), eg: 100" line116="     * @param volume 声の大きさ (0~100), eg: 100" line117="     */" line118="    //% block=&quot;声を変えてしゃべる %text|速さ %speed|高さ %pitch|音量 %volume&quot;" line119="    //% speed.min=50 speed.max=300 speed.defl=100" line120="    //% pitch.min=50 pitch.max=200 pitch.defl=100" line121="    //% volume.min=0 volume.max=100 volume.defl=100" line122="    export function sayWithSettings(text: string, speed: number, pitch: number, volume: number): void {" line123="        let tags = &quot;&lt;SPD VAL=&quot; + speed + &quot;&gt;&lt;PITCH VAL=&quot; + pitch + &quot;&gt;&lt;VOL VAL=&quot; + volume + &quot;&gt;&quot;;" line124="        sendText(tags + text);" line125="    }" line126="" line127="    /**" line128="     * いま喋っている最中なら「真(true)」を返します。" line129="     */" line130="    //% block=&quot;おしゃべり中&quot;" line131="    export function isBusy(): boolean {" line132="        let buf = pins.i2cReadBuffer(I2C_ADDR, 1);" line133="        if (buf.length &gt; 0) {" line134="            let status = buf.getNumber(NumberFormat.UInt8LE, 0);" line135="            return status !== 0x3E; // '&gt;' (0x3E) 以外ならBusy" line136="        }" line137="        return false;" line138="    }" line139="" line140="    /**" line141="     * 話し終わるまで次のプログラムに進まず待ちます。" line142="     */" line143="    //% block=&quot;話し終わるまで待つ&quot;" line144="    export function waitUntilDone(): void {" line145="        while (isBusy()) {" line146="            basic.pause(50);" line147="        }" line148="    }" line149="" line150="    /**" line151="     * おしゃべりを途中で止めます。" line152="     */" line153="    //% block=&quot;声を止める&quot;" line154="    export function stop(): void {" line155="        pins.i2cWriteBuffer(I2C_ADDR, Buffer.fromUTF8(&quot;&gt;&quot;));" line156="    }" line157="" line158="    // 内部処理" line159="    function sendText(text: string): void {" line160="        let buf2 = pins.createBuffer(text.length + 1);" line161="        for (let i = 0; i &lt; text.length; i++) {" line162="            buf2.setNumber(NumberFormat.Int8LE, i, text.charCodeAt(i));" line163="        }" line164="        buf2.setNumber(NumberFormat.Int8LE, text.length, 13); // CR (\r)" line165="        pins.i2cWriteBuffer(I2C_ADDR, buf2);" line166="        basic.pause(20); // 送信直後の判定ブレ防止" line167="    }" line168="}" numlines="169"></mutation></block></statement></block></xml>